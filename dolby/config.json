      "dolby vision", "dolby atmos", "全景声", "视界版", "杜比版"
    ],
    "also_allow_tags": ["4k", "4K原盘", "原盘", "蓝光", "uhd", "hdr"],
    "require_4k_or_bluray": false,
    "drop_keywords": ["抢先版", "枪版", "TC版", "DVD版", "高清枪版"]
